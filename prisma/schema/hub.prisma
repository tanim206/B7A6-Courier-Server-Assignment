model Hub {
  id          String    @id @default(uuid())
  hubCode     String    @unique
  
  name        String    
  email       String?
  phone       String?


  address     String
  city        String
  district    String
  division    String

  status      HubStatus @default(ACTIVE)

  createdById String

  createdBy User @relation("HubCreatedByAdmin",fields: [createdById],references: [id])

  staffs User[] @relation("StaffHub")
  applications HubApplication[]


  originShipments Shipment[] @relation("OriginShipments")
  destinationShipments Shipment[] @relation("DestinationShipments")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  @@index([city])
  @@index([district])
  @@index([division])
  @@index([status])
  @@index([deletedAt])

  @@map("hubs")
}