<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Verify Your Email</title>
  </head>

  <body
    style="
      margin: 0;
      padding: 0;
      background-color: #f4f4f4;
      font-family: Arial, sans-serif;
    "
  >
    <div
      style="
        max-width: 600px;
        margin: 40px auto;
        background: #ffffff;
        padding: 40px;
        border-radius: 12px;
      "
    >
      <h2 style="margin-top: 0">Welcome to Courier & Logistics</h2>

      <p>Hello <strong><%= name %></strong>,</p>

      <p>
        Thank you for creating your account. Please use the OTP below to verify
        your email address.
      </p>

      <div style="margin: 30px 0; text-align: center">
        <span
          style="
            display: inline-block;
            padding: 15px 30px;
            background: #f3f4f6;
            border-radius: 8px;
            font-size: 32px;
            font-weight: bold;
            letter-spacing: 8px;
          "
        >
          <%= otp %>
        </span>
      </div>

      <p>
        This OTP will expire in
        <strong><%= expirationMinutes %> minutes</strong>.
      </p>

      <p>
        If you did not create this account, you can safely ignore this email.
      </p>

      <hr />

      <p style="font-size: 13px; color: #777">
        Courier & Logistics Management Platform
      </p>
    </div>
  </body>
</html>
